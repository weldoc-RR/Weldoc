# Copier ce fichier en ".env" et renseigner une vraie base PostgreSQL.
# Exemple : postgresql://user:password@localhost:5432/weldoc
DATABASE_URL="postgresql://user:password@localhost:5432/weldoc"

# Optionnel : récapitulatif hebdomadaire des alertes par email (voir le
# README, section "Ce qui n'est pas encore fait"). Sans ces deux variables,
# les alertes restent visibles dans l'application mais ne sont pas envoyées.
# RESEND_API_KEY="re_..."
# ALERTES_EMAIL_FROM="alertes@votredomaine.fr"

# Optionnel : secret partagé pour autoriser un déclencheur automatisé
# (ex. Vercel Cron) à appeler /api/alertes/recapitulatif sans compte Weldoc.
# CRON_SECRET="..."

# Dépôt de fichiers direct dans Weldoc (le "drive" : certificats,
# habilitations, qualifications, documents justificatifs...) — voir
# POST /api/upload. Sans cette variable, le dépôt de fichier est
# indisponible mais coller un lien vers un fichier déjà hébergé ailleurs
# continue de fonctionner partout. Pour l'activer sur Vercel : Storage →
# Create Database → Blob dans le tableau de bord du projet, puis copier
# le jeton "BLOB_READ_WRITE_TOKEN" généré (Vercel l'ajoute automatiquement
# aux variables d'environnement du déploiement une fois le store créé et
# connecté au projet).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Lecture automatique des documents déposés (certificats de qualification/
# habilitation) — voir POST /api/lecture-document. Sans cette variable, le
# bouton "Lire automatiquement le document" renvoie une erreur claire mais
# la saisie manuelle continue de fonctionner normalement. Clé obtenue sur
# https://console.anthropic.com (Anthropic, l'éditeur de Claude).
# ANTHROPIC_API_KEY="sk-ant-..."
