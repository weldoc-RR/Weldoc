// ============================================================================
// WELDOC — MODÈLE DE DONNÉES (socle)
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NiveauDecision {
  NIVEAU_1
  NIVEAU_2
  NIVEAU_3
}

model Personnel {
  id              String   @id @default(cuid())
  matricule       String   @unique
  nom             String
  prenom          String
  societe         String
  niveau          NiveauDecision
  qrCodeValeur    String   @unique
  pinHash         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fonctions       PersonnelFonction[]
  qualifications  Qualification[]
  habilitations   Habilitation[]
  formations      Formation[]
  acuitesVisuelles AcuiteVisuelle[]
  chartesAcceptees ChartAcceptation[]
  jointsSoudes    Joint[]              @relation("Soudeur")
  controlesRealises ControleDimensionnel[] @relation("Controleur")
  controlesVisuelsRealises ControleVisuel[] @relation("ControleurVisuel")
  controlesRessuageRealises ControleRessuage[] @relation("ControleurRessuage")
  controlesMagnetoscopieRealises ControleMagnetoscopie[] @relation("ControleurMagnetoscopie")
  controlesRadiographieRealises  ControleRadiographie[]  @relation("ControleurRadiographie")
  controlesUltrasonsRealises     ControleUltrasons[]     @relation("ControleurUltrasons")
  signatures      Signature[]
  indisponibilites Indisponibilite[]
  affectations    Affectation[]
  compte          Compte?

  @@index([societe])
}

// ============================================================================
// AUTHENTIFICATION ET DROITS
// ============================================================================
// Le compte porte uniquement les identifiants de connexion. L'identifiant de
// connexion est le matricule déjà présent sur Personnel (jamais dupliqué).
// Le niveau de décision (1/2/3) qui détermine les droits reste sur Personnel :
// un compte ne fait qu'authentifier une personne qui existe déjà.
enum StatutCompte {
  ACTIF
  SUSPENDU
}

model Compte {
  id                String       @id @default(cuid())
  personnel         Personnel    @relation(fields: [personnelId], references: [id])
  personnelId       String       @unique
  motDePasseHash    String
  statut            StatutCompte @default(ACTIF)
  derniereConnexion DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  sessions          Session[]
}

// Sessions stockées côté serveur (et non un simple jeton auto-suffisant) afin
// de pouvoir les révoquer immédiatement (compte suspendu, déconnexion) et
// garder une trace des connexions.
model Session {
  id         String    @id @default(cuid())
  compte     Compte    @relation(fields: [compteId], references: [id])
  compteId   String
  tokenHash  String    @unique
  creeLe     DateTime  @default(now())
  expireLe   DateTime
  revoqueLe  DateTime?

  @@index([compteId])
}

model PersonnelFonction {
  id          String    @id @default(cuid())
  personnel   Personnel @relation(fields: [personnelId], references: [id])
  personnelId String
  fonction    String

  @@unique([personnelId, fonction])
}

enum TypeQualification {
  SOUDAGE
  CND
}

enum StatutValidite {
  VALIDE
  BIENTOT_ECHEANCE
  EXPIRE
  EN_RENOUVELLEMENT
  SUSPENDU
}

// Le "type de qualification" (BW-A1, FW-I2, SW-A...) et les champs qui en
// précisent le domaine (groupe de matériaux, position, plages
// d'épaisseur/diamètre) sont structurés plutôt que noyés dans
// `domaineValidite` en texte libre, pour permettre plus tard un
// rapprochement automatique avec le domaine de validité d'un WPS (voir la
// limite "QS" documentée dans le README). La désignation exacte dépend du
// référentiel utilisé par l'entreprise ou le client (ISO 9606-1 ou
// équivalent) : Weldoc ne présuppose ni n'impose de nomenclature, ces
// valeurs sont saisies par la personne qui enregistre la qualification —
// voir l'avertissement sur les normes protégées dans
// src/lib/tolerances.ts, aucune valeur n'est pré-remplie par l'application.
model Qualification {
  id             String              @id @default(cuid())
  personnel      Personnel           @relation(fields: [personnelId], references: [id])
  personnelId    String
  type           TypeQualification
  reference      String
  norme          String
  referentiel    Referentiel?        @relation(fields: [referentielId], references: [id])
  referentielId  String?
  procede        String?
  materiaux      String?
  codeQualification String?
  groupeMateriaux   String?
  positionSoudage   String?
  epaisseurMinMm    Float?
  epaisseurMaxMm    Float?
  diametreMinMm     Float?
  diametreMaxMm     Float?
  domaineValidite String?
  // Organisme (ou personne) qui a examiné/délivré la qualification, sous sa
  // responsabilité — pas forcément l'entreprise elle-même. Texte libre : sa
  // forme dépend du référentiel et de qui réalise l'examen.
  organismeExamen String?
  dateObtention  DateTime
  dateExpiration DateTime?
  // Certains référentiels exigent, en plus de l'échéance finale, des
  // confirmations périodiques (ex. tous les 6 mois) pour que la
  // qualification reste valable jusqu'à cette échéance — distinct d'une
  // reconduction/prolongation complète. La périodicité dépend du
  // référentiel/de l'entreprise, jamais imposée par Weldoc ; null = pas de
  // confirmation périodique exigée. La prochaine échéance de confirmation
  // se calcule à la lecture à partir du dernier événement
  // CONFIRMATION_VALIDITE (voir src/lib/confirmationQualification.ts),
  // jamais stockée.
  frequenceConfirmationMois Int?
  statut         StatutValidite @default(VALIDE)
  certificatUrl  String?

  evenements     QualificationEvenement[]

  @@index([personnelId, type])
}

enum TypeEvenementQualification {
  OBTENTION
  CONFIRMATION_VALIDITE
  RECONDUCTION_PROPOSEE
  RECONDUCTION_VALIDEE
  SUSPENSION
  EXPIRATION
}

model QualificationEvenement {
  id              String                      @id @default(cuid())
  qualification   Qualification               @relation(fields: [qualificationId], references: [id])
  qualificationId String
  type            TypeEvenementQualification
  date            DateTime                    @default(now())
  preuveJointIds  String[]
  valideParId     String?
  // Référence libre vers Signature.id (voir plus bas), comme signatureId
  // ailleurs dans l'application — pas de clé étrangère directe, Signature
  // reste générique par (documentType, documentId).
  signatureId     String?
  commentaire     String?
}

// Habilitations (électrique, accès site, engins...) : conceptuellement
// proches des qualifications soudage/CND mais plus génériques. Un
// renouvellement n'écrase jamais l'ancien enregistrement : c'est une
// nouvelle ligne, l'historique reste visible via la liste complète.
model Habilitation {
  id             String         @id @default(cuid())
  personnel      Personnel      @relation(fields: [personnelId], references: [id])
  personnelId    String
  intitule       String
  reference      String?
  dateObtention  DateTime
  dateExpiration DateTime?
  statut         StatutValidite @default(VALIDE)
  certificatUrl  String?
  createdAt      DateTime       @default(now())

  @@index([personnelId])
}

// Formations suivies. Comme pour les habilitations, un recyclage se
// traduit par un nouvel enregistrement plutôt qu'une modification du
// précédent.
model Formation {
  id              String         @id @default(cuid())
  personnel       Personnel      @relation(fields: [personnelId], references: [id])
  personnelId     String
  intitule        String
  organisme       String?
  dateRealisation DateTime
  dateExpiration  DateTime?
  statut          StatutValidite @default(VALIDE)
  certificatUrl   String?
  createdAt       DateTime       @default(now())

  @@index([personnelId])
}

// Test d'acuité visuelle (near/far, perception des couleurs selon le cas) :
// exigence réglementaire récurrente pour soudeurs et contrôleurs.
model AcuiteVisuelle {
  id             String         @id @default(cuid())
  personnel      Personnel      @relation(fields: [personnelId], references: [id])
  personnelId    String
  dateTest       DateTime
  dateExpiration DateTime?
  apte           Boolean
  organisme      String?
  certificatUrl  String?
  statut         StatutValidite @default(VALIDE)
  createdAt      DateTime       @default(now())

  @@index([personnelId])
}

// Charte d'utilisation et d'intégrité (voir cahier des charges,
// "Identification et signature") : doit être acceptée avant toute
// signature de document, et réacceptée à chaque nouvelle version. Une
// nouvelle version est une nouvelle ligne, jamais une modification de la
// précédente ; la version "en vigueur" est simplement la plus récente par
// `publieLe` (calculée à la lecture, comme ailleurs dans l'application).
model ChartVersion {
  id            String   @id @default(cuid())
  version       String   @unique
  contenu       String
  publieLe      DateTime @default(now())
  acceptations  ChartAcceptation[]
}

model ChartAcceptation {
  id             String       @id @default(cuid())
  personnel      Personnel    @relation(fields: [personnelId], references: [id])
  personnelId    String
  chartVersion   ChartVersion @relation(fields: [chartVersionId], references: [id])
  chartVersionId String
  dateAcceptation DateTime    @default(now())

  @@unique([personnelId, chartVersionId])
}

// Le cahier des charges est écrit en vocabulaire "chantier", mais Weldoc doit
// aussi pouvoir suivre une fabrication en atelier (où "chantier"/"site" au
// sens travaux n'ont pas forcément de sens) : typeRealisation permet aux
// futurs modules de s'adapter, et chantier/site redeviennent optionnels.
enum TypeRealisation {
  CHANTIER
  ATELIER
}

model Affaire {
  id                String   @id @default(cuid())
  numero            String   @unique
  client            String
  projet            String
  typeRealisation   TypeRealisation @default(CHANTIER)
  chantier          String?
  site              String?
  responsableId     String?
  chargeAffairesId  String?
  coordinateurSoudageId String?
  dateDebut         DateTime?
  dateFin           DateTime?
  cahierDesChargesUrl String?
  createdAt         DateTime @default(now())

  referentiels      AffaireReferentiel[]
  matieres          Matiere[]
  joints            Joint[]
  fncs              FNC[]
  sequences         Sequence[]
  affectations      Affectation[]
  demandesSequencement DemandeModificationSequencement[]
  pieces            Piece[]
}

model Referentiel {
  id          String  @id @default(cuid())
  code        String  @unique
  domaine     String
  version     String?
  affaires    AffaireReferentiel[]
  qualifications Qualification[]
}

model AffaireReferentiel {
  id            String      @id @default(cuid())
  affaire       Affaire     @relation(fields: [affaireId], references: [id])
  affaireId     String
  referentiel   Referentiel @relation(fields: [referentielId], references: [id])
  referentielId String

  @@unique([affaireId, referentielId])
}

model Sequence {
  id         String   @id @default(cuid())
  affaire    Affaire  @relation(fields: [affaireId], references: [id])
  affaireId  String
  ordre      Int
  nom        String
  phases     Phase[]
}

enum StatutPhase {
  A_FAIRE
  EN_COURS
  TERMINEE
  NON_APPLICABLE
}

model Phase {
  id           String      @id @default(cuid())
  sequence     Sequence    @relation(fields: [sequenceId], references: [id])
  sequenceId   String
  ordre        Int
  nom          String
  obligatoire  Boolean     @default(true)
  statut       StatutPhase @default(A_FAIRE)
  justificationNA String?
}

model Matiere {
  id             String   @id @default(cuid())
  affaire        Affaire  @relation(fields: [affaireId], references: [id])
  affaireId      String
  fournisseur    String
  designation    String
  reference      String?
  normeProduit   String
  nuance         String
  diametre       Float?
  epaisseur      Float?
  finition       String?
  etat           String?
  numeroCoulee   String
  numeroLot      String?
  ccpuDocumentUrl String?
  certificatUrl  String?

  joints         Joint[]

  @@index([numeroCoulee])
}

model Joint {
  id              String   @id @default(cuid())
  numero          String
  affaire         Affaire  @relation(fields: [affaireId], references: [id])
  affaireId       String
  ligne           String?
  spool           String?
  typeJoint       String?
  dn              String?
  diametre        Float?
  epaisseur       Float?
  matiere         Matiere? @relation(fields: [matiereId], references: [id])
  matiereId       String?
  // wpsReference/qmosReference restent en texte libre pour les cas non
  // encore couverts par la bibliothèque (voir Wps/Qmos ci-dessous) ; wpsId/
  // qmosId sont le lien structuré vers une fiche réutilisable quand elle
  // existe — les deux peuvent coexister le temps que la bibliothèque se
  // remplisse.
  wpsReference    String?
  wps             Wps?     @relation(fields: [wpsId], references: [id])
  wpsId           String?
  qmosReference   String?
  qmos            Qmos?    @relation(fields: [qmosId], references: [id])
  qmosId          String?
  qsReference     String?
  soudeur         Personnel? @relation("Soudeur", fields: [soudeurId], references: [id])
  soudeurId       String?
  consommableLot  String?

  jointParent     Joint?   @relation("Reparations", fields: [jointParentId], references: [id])
  jointParentId   String?
  reparations     Joint[]  @relation("Reparations")
  indiceReparation Int     @default(0)
  // Nature de l'action de remise en conformité pour ce joint, quand c'est
  // une réparation (null pour un joint d'origine, indiceReparation 0).
  typeAction      TypeActionRemiseEnConformite?

  ficheSoudage    FicheTechniqueSoudage?
  controlesDim    ControleDimensionnel[]
  controlesVisuels ControleVisuel[]
  controlesRessuage ControleRessuage[]
  controlesMagnetoscopie ControleMagnetoscopie[]
  controlesRadiographie  ControleRadiographie[]
  controlesUltrasons     ControleUltrasons[]
  fncs            FNC[]
  // FNC dont CE joint (une réparation) est l'action corrective — distinct
  // de `fncs`, qui liste les FNC ouvertes SUR ce joint.
  fncsResolues    FNC[]    @relation("ActionCorrectiveFNC")
  affectations    Affectation[]

  @@unique([affaireId, numero, indiceReparation])
  @@index([affaireId])
}

model FicheTechniqueSoudage {
  id                    String   @id @default(cuid())
  joint                 Joint    @relation(fields: [jointId], references: [id])
  jointId               String   @unique
  procede               String?
  preechauffageC        Float?
  temperatureInterpasses Float?
  postchauffageC        Float?
  tensionV              Float?
  intensiteA            Float?
  vitesseMmMin          Float?
  nombrePasses          Int?
  tempsMin              Float?
  observations          String?
  photosUrls            String[]
  signatureId           String?
}

enum StatutOutil {
  VALIDE
  EXPIRE
  HORS_SERVICE
}

model Outil {
  id              String      @id @default(cuid())
  reference       String      @unique
  type            String
  fabricant       String?
  numeroSerie     String?
  dateVerification DateTime?
  dateEcheance    DateTime?
  statut          StatutOutil @default(VALIDE)
  certificatUrl   String?
  qrCodeValeur    String      @unique

  controles       ControleDimensionnel[]
}

enum ResultatConformite {
  CONFORME
  HORS_TOLERANCE
  A_VERIFIER
}

model ControleDimensionnel {
  id             String              @id @default(cuid())
  joint          Joint               @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel           @relation("Controleur", fields: [controleurId], references: [id])
  controleurId   String
  outil          Outil?              @relation(fields: [outilId], references: [id])
  outilId        String?
  dateControle   DateTime            @default(now())
  mesures        Json
  criteresAppliques Json
  resultat       ResultatConformite
  signatureId    String?

  fncsGenerees   FNC[]
}

// ============================================================================
// CONTRÔLE VISUEL ET CND (VT, PT/ressuage — MT/RT/UT à construire de la même
// façon, module par module)
// ============================================================================
// Résultat générique conforme/non conforme/à vérifier, distinct de
// ResultatConformite (propre aux tolérances dimensionnelles) car les termes
// n'ont pas le même sens pour une indication visuelle ou CND.
enum ResultatControle {
  CONFORME
  NON_CONFORME
  A_VERIFIER
}

// Les 6 champs numeroPV.../moyensUtilises ci-dessous (et sur les 4 autres
// méthodes de contrôle plus bas) sont propres au procès-verbal lui-même,
// distincts de ce qui est déjà tracé ailleurs (type de joint, diamètre,
// épaisseur, matière restent sur Joint ; jamais redemandés ici, voir le
// PRINCIPE CENTRAL du cahier des charges). Tous facultatifs et en texte
// libre : leurs valeurs possibles dépendent du référentiel de l'entreprise,
// jamais imposées par Weldoc.
model ControleVisuel {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurVisuel", fields: [controleurId], references: [id])
  controleurId   String
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  // Indications : localisation, nature, dimensions, critère applicable,
  // conforme (bool), commentaire, photoUrl — une indication conforme reste
  // documentée, elle ne signifie pas automatiquement une non-conformité.
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  controlesRessuagePrealable ControleRessuage[]
  fncsGenerees   FNC[]

  @@index([jointId])
}

enum TypeConsommableCND {
  PENETRANT
  REVELATEUR
  NETTOYANT
}

// Bibliothèque des consommables CND : un produit/lot est enregistré une
// seule fois puis réutilisé sur chaque PV qui l'a employé, plutôt que
// ressaisi à chaque contrôle.
model ConsommableCND {
  id            String             @id @default(cuid())
  type          TypeConsommableCND
  fabricant     String
  reference     String
  lot           String
  peremption    DateTime?
  certificatUrl String?

  utilisations  ControleRessuageConsommable[]

  @@unique([type, fabricant, reference, lot])
}

model ControleRessuage {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurRessuage", fields: [controleurId], references: [id])
  controleurId   String
  // Le contrôle visuel préalable est obligatoire : on ne fait pas de
  // ressuage sur un joint dont l'état de surface n'a pas été vérifié.
  controleVisuelPrealable   ControleVisuel @relation(fields: [controleVisuelPrealableId], references: [id])
  controleVisuelPrealableId String
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  consommables   ControleRessuageConsommable[]
  fncsGenerees   FNC[]

  @@index([jointId])
}

model ControleRessuageConsommable {
  id                 String           @id @default(cuid())
  controleRessuage   ControleRessuage @relation(fields: [controleRessuageId], references: [id])
  controleRessuageId String
  consommable        ConsommableCND   @relation(fields: [consommableId], references: [id])
  consommableId      String

  @@unique([controleRessuageId, consommableId])
}

// MT/RT/UT : même structure que le contrôle visuel (indications en JSON,
// résultat déduit des indications, FNC automatique si non conforme). Pas
// de bibliothèque de consommables pour ces trois-là dans cette première
// version — contrairement au ressuage, leur traçabilité porte surtout sur
// l'équipement/la source/le film, hors du périmètre actuel.
model ControleMagnetoscopie {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurMagnetoscopie", fields: [controleurId], references: [id])
  controleurId   String
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  fncsGenerees   FNC[]

  @@index([jointId])
}

model ControleRadiographie {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurRadiographie", fields: [controleurId], references: [id])
  controleurId   String
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  fncsGenerees   FNC[]

  @@index([jointId])
}

model ControleUltrasons {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurUltrasons", fields: [controleurId], references: [id])
  controleurId   String
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  fncsGenerees   FNC[]

  @@index([jointId])
}

enum StatutFNC {
  DETECTION
  ANALYSE
  ACTION_CORRECTIVE
  CONTROLE
  VALIDATION
  CLOTUREE
}

enum ImpactFNC {
  BLOQUANTE
  NON_BLOQUANTE
  REGLEMENTAIREMENT_SENSIBLE
}

model FNC {
  id                String    @id @default(cuid())
  reference         String    @unique
  affaire           Affaire   @relation(fields: [affaireId], references: [id])
  affaireId         String
  joint             Joint?    @relation(fields: [jointId], references: [id])
  jointId           String?
  controleOrigine   ControleDimensionnel? @relation(fields: [controleOrigineId], references: [id])
  controleOrigineId String?
  // Une FNC ne peut avoir qu'une seule origine parmi les contrôles
  // ci-dessous. Un champ par type de contrôle plutôt qu'une relation
  // polymorphe unique, pour rester cohérent avec controleOrigine ci-dessus ;
  // à revoir si le nombre de méthodes CND grandit encore.
  controleVisuelOrigine   ControleVisuel? @relation(fields: [controleVisuelOrigineId], references: [id])
  controleVisuelOrigineId String?
  controleRessuageOrigine   ControleRessuage? @relation(fields: [controleRessuageOrigineId], references: [id])
  controleRessuageOrigineId String?
  controleMagnetoscopieOrigine   ControleMagnetoscopie? @relation(fields: [controleMagnetoscopieOrigineId], references: [id])
  controleMagnetoscopieOrigineId String?
  controleRadiographieOrigine    ControleRadiographie?  @relation(fields: [controleRadiographieOrigineId], references: [id])
  controleRadiographieOrigineId  String?
  controleUltrasonsOrigine       ControleUltrasons?     @relation(fields: [controleUltrasonsOrigineId], references: [id])
  controleUltrasonsOrigineId     String?
  description       String
  impact            ImpactFNC
  statut            StatutFNC @default(DETECTION)
  actionCorrective  String?
  // Le joint de réparation qui constitue l'action corrective de cette FNC
  // (voir POST /api/joints/[id]/reparation). Distinct de `joint` ci-dessus,
  // qui est le joint sur lequel la FNC a été détectée.
  actionCorrectiveJoint   Joint?    @relation("ActionCorrectiveFNC", fields: [actionCorrectiveJointId], references: [id])
  actionCorrectiveJointId String?
  dateCreation      DateTime  @default(now())
  dateCloture       DateTime?
  valideeParId      String?
}

// Actions possibles de remise en conformité, comme listées au cahier des
// charges.
enum TypeActionRemiseEnConformite {
  REPARATION
  MEULAGE
  RESURFACAGE
  REPRISE
  REMPLACEMENT
  CONTROLE_COMPLEMENTAIRE
}

// Une signature n'est produite qu'au bout du parcours demandé au cahier des
// charges : identification (QR ou matricule) → authentification (PIN,
// haché comme un mot de passe — voir Personnel.pinHash) → vérification que
// la charte en vigueur a été acceptée → création de cet enregistrement
// (horodatage automatique). Voir POST /api/signatures. `documentType`/
// `documentId` restent génériques (pas de clé étrangère) car une signature
// peut porter sur n'importe quel type de document (contrôle, fiche de
// soudage, événement de qualification...) ; chaque table qui peut être
// signée porte son propre `signatureId` en texte libre, jamais une relation
// directe vers ce modèle.
model Signature {
  id             String    @id @default(cuid())
  personnel      Personnel @relation(fields: [personnelId], references: [id])
  personnelId    String
  documentType   String
  documentId     String
  dateSignature  DateTime  @default(now())
  versionDocument String

  @@index([documentType, documentId])
}

model AuditTrail {
  id            String   @id @default(cuid())
  utilisateurId String
  date          DateTime @default(now())
  entite        String
  entiteId      String
  ancienneValeur Json?
  nouvelleValeur Json?
  motif         String?
}

// ============================================================================
// PLANNING ET ORGANIGRAMME
// ============================================================================
// Une indisponibilité déclarée (congé, maladie, formation, autre) : sert de
// base à la détection de conflit avant affectation.
model Indisponibilite {
  id          String    @id @default(cuid())
  personnel   Personnel @relation(fields: [personnelId], references: [id])
  personnelId String
  dateDebut   DateTime
  dateFin     DateTime
  motif       String
  createdAt   DateTime  @default(now())

  @@index([personnelId])
}

enum StatutAffectation {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

// Affecter une personne à une affaire (et éventuellement un joint précis).
// La vérification (qualification, habilitation, disponibilité, compétence)
// se fait à la création et produit des alertes — voir src/lib/planning.ts —
// mais ne bloque jamais la création : conformément au cahier des charges
// ("signale... peut proposer"), Weldoc alerte, la décision reste humaine.
model Affectation {
  id          String            @id @default(cuid())
  personnel   Personnel         @relation(fields: [personnelId], references: [id])
  personnelId String
  affaire     Affaire           @relation(fields: [affaireId], references: [id])
  affaireId   String
  joint       Joint?            @relation(fields: [jointId], references: [id])
  jointId     String?
  fonction    String
  dateDebut   DateTime
  dateFin     DateTime
  statut      StatutAffectation @default(PLANIFIEE)
  creeParId   String
  createdAt   DateTime          @default(now())

  @@index([personnelId])
  @@index([affaireId])
}

// Adresses email destinataires du récapitulatif d'alertes (envoyé chaque
// lundi — voir src/lib/alertesEmail.ts). Volontairement une simple liste
// d'adresses plutôt que rattachée à une fiche Personnel : ce ne sont pas
// forcément des comptes Weldoc (ex. la boîte mail d'un responsable qualité).
model DestinataireAlerte {
  id        String   @id @default(cuid())
  nom       String?
  email     String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================================
// SÉQUENCEMENT DU DOSSIER DE FABRICATION
// ============================================================================
enum StatutDemandeSequencement {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  MODIFICATION_DEMANDEE
}

// Demande de modification du séquencement envoyée par le terrain (ex. faire
// une phase avant une autre non encore terminée). Transmise au niveau 3, qui
// accepte/refuse/demande une modification/impose des conditions — jamais
// décidée automatiquement. Une demande ACCEPTEE autorise, pour les phases
// qu'elle liste, à passer outre le blocage "séquence précédente non
// terminée" (voir POST /api/phases et PATCH /api/phases).
model DemandeModificationSequencement {
  id                  String                    @id @default(cuid())
  affaire             Affaire                   @relation(fields: [affaireId], references: [id])
  affaireId           String
  phasesConcerneesIds String[]
  motif               String
  urgent              Boolean                   @default(false)
  photoUrl            String?
  documentUrl         String?
  demandeParId        String
  dateDemande         DateTime                  @default(now())
  statut              StatutDemandeSequencement @default(EN_ATTENTE)
  decisionParId       String?
  dateDecision        DateTime?
  commentaireDecision String?
  conditions          String?

  @@index([affaireId])
}

// ============================================================================
// PIÈCES (fabrication en atelier)
// ============================================================================
// Contrairement au chantier, où les joints d'une affaire sont en général
// connus à l'avance, une fabrication en atelier reçoit souvent des pièces
// au fil de l'eau. Une Pièce trace sa prise en charge (référence, photos
// des repères présents dessus comme preuve) et son statut au fil de
// l'activité — indépendamment des joints, qui restent la soudure elle-même.
enum StatutPiece {
  PRISE_EN_CHARGE
  EN_FABRICATION
  TERMINEE
  EXPEDIEE
}

model Piece {
  id                 String      @id @default(cuid())
  affaire            Affaire     @relation(fields: [affaireId], references: [id])
  affaireId          String
  reference          String
  designation        String?
  photosUrls         String[]
  priseEnChargeParId String
  datePriseEnCharge  DateTime    @default(now())
  statut             StatutPiece @default(PRISE_EN_CHARGE)

  @@unique([affaireId, reference])
  @@index([affaireId])
}

// ============================================================================
// BIBLIOTHÈQUE WPS/DMOS ET QMOS
// ============================================================================
// Une révision de WPS ou de QMOS n'écrase jamais la précédente : c'est un
// nouvel enregistrement, avec la même `reference` métier (ex. "DMOS-001")
// et une `version` différente (ex. "Rev 0", "Rev 1"). La version "en
// vigueur" n'est jamais stockée : elle est calculée à la lecture (la plus
// récente par dateEmission pour une référence donnée, voir
// src/lib/procedures.ts), comme le statut des qualifications ou de
// l'outillage ailleurs dans l'application. `retiree` est la seule chose
// qu'une personne peut positionner explicitement (ex. norme devenue
// obsolète), sans jamais modifier le contenu d'une version existante.
model Qmos {
  id             String    @id @default(cuid())
  reference      String
  version        String    @default("Rev 0")
  procede        String
  normeReference String
  laboratoire    String?
  dateEssai      DateTime?
  certificatUrl  String?
  retiree        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  wps            Wps[]
  joints         Joint[]

  @@unique([reference, version])
  @@index([reference])
}

// Type d'assemblage soudé, terminologie générique (pas propre à un
// référentiel) : bout-à-bout, angle, emmanché-soudé, rechargement.
enum TypeAssemblageSoudure {
  BOUT_A_BOUT
  ANGLE
  EMMANCHE_SOUDE
  RECHARGEMENT
  AUTRE
}

model Wps {
  id             String    @id @default(cuid())
  reference      String
  version        String    @default("Rev 0")
  typeAssemblage TypeAssemblageSoudure?
  procede        String
  normeReference String
  materiaux      String?
  // Groupe de matériaux (ex. ISO/TR 15608), structuré comme sur
  // Qualification.groupeMateriaux — c'est ce champ, avec procede, qui sert
  // de base au rapprochement automatique QS/WPS (voir
  // src/lib/verificationQS.ts), pas le texte libre `materiaux` ci-dessus.
  groupeMateriaux String?
  epaisseurMinMm Float?
  epaisseurMaxMm Float?
  diametreMinMm  Float?
  diametreMaxMm  Float?
  positions      String?
  // Notes libres sur la préparation (talon, jeu, mode de préparation,
  // support envers...) : le schéma lui-même (image/PDF) reste dans
  // documentUrl, pas reproduit en texte ici.
  preparationNotes String?
  qmos           Qmos?     @relation(fields: [qmosId], references: [id])
  qmosId         String?
  documentUrl    String?
  dateEmission   DateTime
  retiree        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  joints         Joint[]
  passes         WpsPasse[]

  @@unique([reference, version])
  @@index([reference])
}

// Détail passe par passe d'un WPS/DMOS : ce qu'un soudeur suit réellement
// pendant le soudage. Créé avec le WPS et jamais modifié ensuite (comme le
// reste d'une révision) — une correction se fait via une nouvelle révision
// du WPS, avec ses propres passes.
model WpsPasse {
  id             String  @id @default(cuid())
  wps            Wps     @relation(fields: [wpsId], references: [id])
  wpsId          String
  ordre          Int
  procede        String
  modeOperatoire String?
  position       String?
  metalApportType String?
  metalApportDesignationNormalisee  String?
  metalApportDesignationCommerciale String?
  metalApportDiametreMm Float?
  gazEndroitNature   String?
  gazEndroitDebit    String?
  gazEnversNature    String?
  gazEnversDebit     String?
  natureCourantPolarite String?
  intensiteAMin      Float?
  intensiteAMax      Float?
  tensionVMin        Float?
  tensionVMax        Float?
  temperatureMiniPieceC       Float?
  temperatureMaxiEntrePassesC Float?
  observations   String?

  @@index([wpsId])
}
