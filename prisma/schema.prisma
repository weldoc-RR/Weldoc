// ============================================================================
// WELDOC — MODÈLE DE DONNÉES (socle)
// ============================================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum NiveauDecision {
  NIVEAU_1
  NIVEAU_2
  NIVEAU_3
}

model Personnel {
  id              String   @id @default(cuid())
  matricule       String   @unique
  nom             String
  prenom          String
  societe         String
  niveau          NiveauDecision
  qrCodeValeur    String   @unique
  pinHash         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fonctions       PersonnelFonction[]
  qualifications  Qualification[]
  habilitations   Habilitation[]
  formations      Formation[]
  acuitesVisuelles AcuiteVisuelle[]
  chartesAcceptees ChartAcceptation[]
  jointsSoudes    Joint[]              @relation("Soudeur")
  controlesRealises ControleDimensionnel[] @relation("Controleur")
  controlesVisuelsRealises ControleVisuel[] @relation("ControleurVisuel")
  controlesRessuageRealises ControleRessuage[] @relation("ControleurRessuage")
  controlesMagnetoscopieRealises ControleMagnetoscopie[] @relation("ControleurMagnetoscopie")
  controlesRadiographieRealises  ControleRadiographie[]  @relation("ControleurRadiographie")
  controlesUltrasonsRealises     ControleUltrasons[]     @relation("ControleurUltrasons")
  signatures      Signature[]
  indisponibilites Indisponibilite[]
  affectations    Affectation[]
  compte          Compte?
  photosAjoutees  Photo[]              @relation("AuteurPhoto")
  notesRexAjoutees NoteRex[]           @relation("AuteurNoteRex")
  evenementsPointsReglementaires PointReglementaireEvenement[]
  pvExternesImportes PVExterne[]       @relation("ImporteurPVExterne")
  pvExternesRevises  PVExterne[]       @relation("ReviseurPVExterne")
  etatsDesLieuxRediges EtatDesLieux[]
  documentsExternesImportes DocumentExterne[] @relation("ImporteurDocumentExterne")
  documentsExternesValides  DocumentExterne[] @relation("ValidateurDocumentExterne")
  documentsExternesConcerne DocumentExterne[] @relation("PersonnelConcerneDocumentExterne")
  fichesRexRedigees FicheREX[]
  scansTqcRealises  ScanTqc[] @relation("OperateurScanTqc")
  autorisationsSignature AutorisationSignature[]
  autorisationsSignatureAccordees AutorisationSignature[] @relation("AccordeParAutorisationSignature")
  documentsJustificatifs DocumentJustificatifPersonnel[]
  documentsJustificatifsAjoutes DocumentJustificatifPersonnel[] @relation("AjouteParDocumentJustificatif")

  @@index([societe])
}

// ============================================================================
// AUTHENTIFICATION ET DROITS
// ============================================================================
// Le compte porte uniquement les identifiants de connexion. L'identifiant de
// connexion est le matricule déjà présent sur Personnel (jamais dupliqué).
// Le niveau de décision (1/2/3) qui détermine les droits reste sur Personnel :
// un compte ne fait qu'authentifier une personne qui existe déjà.
enum StatutCompte {
  ACTIF
  SUSPENDU
}

model Compte {
  id                String       @id @default(cuid())
  personnel         Personnel    @relation(fields: [personnelId], references: [id])
  personnelId       String       @unique
  motDePasseHash    String
  statut            StatutCompte @default(ACTIF)
  derniereConnexion DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  sessions          Session[]
}

// Sessions stockées côté serveur (et non un simple jeton auto-suffisant) afin
// de pouvoir les révoquer immédiatement (compte suspendu, déconnexion) et
// garder une trace des connexions.
model Session {
  id         String    @id @default(cuid())
  compte     Compte    @relation(fields: [compteId], references: [id])
  compteId   String
  tokenHash  String    @unique
  creeLe     DateTime  @default(now())
  expireLe   DateTime
  revoqueLe  DateTime?

  @@index([compteId])
}

model PersonnelFonction {
  id          String    @id @default(cuid())
  personnel   Personnel @relation(fields: [personnelId], references: [id])
  personnelId String
  fonction    String

  @@unique([personnelId, fonction])
}

enum TypeQualification {
  SOUDAGE
  CND
}

enum StatutValidite {
  VALIDE
  BIENTOT_ECHEANCE
  EXPIRE
  EN_RENOUVELLEMENT
  SUSPENDU
}

// Le "type de qualification" (BW-A1, FW-I2, SW-A...) et les champs qui en
// précisent le domaine (groupe de matériaux, position, plages
// d'épaisseur/diamètre) sont structurés plutôt que noyés dans
// `domaineValidite` en texte libre, pour permettre plus tard un
// rapprochement automatique avec le domaine de validité d'un WPS (voir la
// limite "QS" documentée dans le README). La désignation exacte dépend du
// référentiel utilisé par l'entreprise ou le client (ISO 9606-1 ou
// équivalent) : Weldoc ne présuppose ni n'impose de nomenclature, ces
// valeurs sont saisies par la personne qui enregistre la qualification —
// voir l'avertissement sur les normes protégées dans
// src/lib/tolerances.ts, aucune valeur n'est pré-remplie par l'application.
model Qualification {
  id             String              @id @default(cuid())
  personnel      Personnel           @relation(fields: [personnelId], references: [id])
  personnelId    String
  type           TypeQualification
  reference      String
  norme          String
  referentiel    Referentiel?        @relation(fields: [referentielId], references: [id])
  referentielId  String?
  procede        String?
  materiaux      String?
  codeQualification String?
  groupeMateriaux   String?
  positionSoudage   String?
  epaisseurMinMm    Float?
  epaisseurMaxMm    Float?
  diametreMinMm     Float?
  diametreMaxMm     Float?
  domaineValidite String?
  // Organisme (ou personne) qui a examiné/délivré la qualification, sous sa
  // responsabilité — pas forcément l'entreprise elle-même. Texte libre : sa
  // forme dépend du référentiel et de qui réalise l'examen.
  organismeExamen String?
  dateObtention  DateTime
  dateExpiration DateTime?
  // Certains référentiels exigent, en plus de l'échéance finale, des
  // confirmations périodiques (ex. tous les 6 mois) pour que la
  // qualification reste valable jusqu'à cette échéance — distinct d'une
  // reconduction/prolongation complète. La périodicité dépend du
  // référentiel/de l'entreprise, jamais imposée par Weldoc ; null = pas de
  // confirmation périodique exigée. La prochaine échéance de confirmation
  // se calcule à la lecture à partir du dernier événement
  // CONFIRMATION_VALIDITE (voir src/lib/confirmationQualification.ts),
  // jamais stockée.
  frequenceConfirmationMois Int?
  statut         StatutValidite @default(VALIDE)
  certificatUrl  String?

  evenements     QualificationEvenement[]

  @@index([personnelId, type])
}

enum TypeEvenementQualification {
  OBTENTION
  CONFIRMATION_VALIDITE
  RECONDUCTION_PROPOSEE
  RECONDUCTION_VALIDEE
  SUSPENSION
  EXPIRATION
}

model QualificationEvenement {
  id              String                      @id @default(cuid())
  qualification   Qualification               @relation(fields: [qualificationId], references: [id])
  qualificationId String
  type            TypeEvenementQualification
  date            DateTime                    @default(now())
  preuveJointIds  String[]
  valideParId     String?
  // Référence libre vers Signature.id (voir plus bas), comme signatureId
  // ailleurs dans l'application — pas de clé étrangère directe, Signature
  // reste générique par (documentType, documentId).
  signatureId     String?
  commentaire     String?
}

// Habilitations (électrique, accès site, engins...) : conceptuellement
// proches des qualifications soudage/CND mais plus génériques. Un
// renouvellement n'écrase jamais l'ancien enregistrement : c'est une
// nouvelle ligne, l'historique reste visible via la liste complète.
model Habilitation {
  id             String         @id @default(cuid())
  personnel      Personnel      @relation(fields: [personnelId], references: [id])
  personnelId    String
  intitule       String
  reference      String?
  dateObtention  DateTime
  dateExpiration DateTime?
  statut         StatutValidite @default(VALIDE)
  certificatUrl  String?
  createdAt      DateTime       @default(now())

  @@index([personnelId])
}

// Formations suivies. Comme pour les habilitations, un recyclage se
// traduit par un nouvel enregistrement plutôt qu'une modification du
// précédent.
model Formation {
  id              String         @id @default(cuid())
  personnel       Personnel      @relation(fields: [personnelId], references: [id])
  personnelId     String
  intitule        String
  organisme       String?
  dateRealisation DateTime
  dateExpiration  DateTime?
  statut          StatutValidite @default(VALIDE)
  certificatUrl   String?
  createdAt       DateTime       @default(now())

  @@index([personnelId])
}

// Test d'acuité visuelle (near/far, perception des couleurs selon le cas) :
// exigence réglementaire récurrente pour soudeurs et contrôleurs.
model AcuiteVisuelle {
  id             String         @id @default(cuid())
  personnel      Personnel      @relation(fields: [personnelId], references: [id])
  personnelId    String
  dateTest       DateTime
  dateExpiration DateTime?
  apte           Boolean
  organisme      String?
  certificatUrl  String?
  statut         StatutValidite @default(VALIDE)
  createdAt      DateTime       @default(now())

  @@index([personnelId])
}

// Documents justificatifs du personnel (voir le cahier des charges,
// fiche personne : "..., documents justificatifs, ..."), au-delà des
// qualifications/habilitations/formations/acuités visuelles déjà
// modélisées : tout document libre attaché à une personne (pièce
// d'identité, permis, CACES, autorisation spécifique...). Même principe
// que les CCPU/documents externes : un lien vers un fichier déjà
// hébergé, pas de téléversement direct dans Weldoc. Un renouvellement
// (nouvelle pièce, nouvelle échéance) est un nouvel enregistrement,
// jamais une modification du précédent (même regroupement "actuel +
// historique" que les habilitations sur /personnel).
model DocumentJustificatifPersonnel {
  id             String         @id @default(cuid())
  personnel      Personnel      @relation(fields: [personnelId], references: [id])
  personnelId    String
  intitule       String
  reference      String?
  documentUrl    String
  dateDocument   DateTime?
  dateExpiration DateTime?
  statut         StatutValidite @default(VALIDE)
  ajoutePar      Personnel      @relation("AjouteParDocumentJustificatif", fields: [ajouteParId], references: [id])
  ajouteParId    String
  createdAt      DateTime       @default(now())

  @@index([personnelId])
}

// Charte d'utilisation et d'intégrité (voir cahier des charges,
// "Identification et signature") : doit être acceptée avant toute
// signature de document, et réacceptée à chaque nouvelle version. Une
// nouvelle version est une nouvelle ligne, jamais une modification de la
// précédente ; la version "en vigueur" est simplement la plus récente par
// `publieLe` (calculée à la lecture, comme ailleurs dans l'application).
model ChartVersion {
  id            String   @id @default(cuid())
  version       String   @unique
  contenu       String
  publieLe      DateTime @default(now())
  acceptations  ChartAcceptation[]
}

model ChartAcceptation {
  id             String       @id @default(cuid())
  personnel      Personnel    @relation(fields: [personnelId], references: [id])
  personnelId    String
  chartVersion   ChartVersion @relation(fields: [chartVersionId], references: [id])
  chartVersionId String
  dateAcceptation DateTime    @default(now())

  @@unique([personnelId, chartVersionId])
}

// Le cahier des charges est écrit en vocabulaire "chantier", mais Weldoc doit
// aussi pouvoir suivre une fabrication en atelier (où "chantier"/"site" au
// sens travaux n'ont pas forcément de sens) : typeRealisation permet aux
// futurs modules de s'adapter, et chantier/site redeviennent optionnels.
enum TypeRealisation {
  CHANTIER
  ATELIER
}

model Affaire {
  id                String   @id @default(cuid())
  numero            String   @unique
  client            String
  projet            String
  typeRealisation   TypeRealisation @default(CHANTIER)
  chantier          String?
  site              String?
  responsableId     String?
  chargeAffairesId  String?
  coordinateurSoudageId String?
  dateDebut         DateTime?
  dateFin           DateTime?
  cahierDesChargesUrl String?
  // Nombre de joints prévus sur l'affaire, saisi une fois (ex. d'après le
  // plan d'isométrie) pour permettre un avancement "38 joints soudés sur
  // 120 prévus" en plus de l'avancement par phase — voir
  // src/lib/avancement.ts. Simple champ éditable comme les autres
  // informations générales de l'affaire (client, projet, dates...), pas
  // une donnée réglementaire tracée par l'audit trail.
  nombreJointsPrevus Int?
  // Types de contrôle exigés sur chaque joint d'origine de l'affaire (DIM,
  // VT, PT, MT, RT, UT — mêmes sigles que BadgeControle), saisi une fois
  // pour permettre l'alerte "contrôles manquants" (voir le cahier des
  // charges, "ALERTES") : src/lib/controlesManquants.ts compare cette
  // liste aux contrôles réellement enregistrés sur chaque joint. Vide par
  // défaut = comportement additif, aucune alerte tant que rien n'est
  // déclaré (même principe que MatierePrevue/AutorisationSignature).
  controlesRequis  String[] @default([])
  // Types de document exigés sur chaque joint d'origine de l'affaire
  // (FICHE_SOUDAGE, CCPU_MATIERE, CERTIFICAT_MATIERE, TQC — voir
  // src/lib/documentsManquants.ts), même principe additif que
  // controlesRequis ci-dessus : vide par défaut, aucune alerte tant que
  // rien n'est déclaré.
  documentsRequis  String[] @default([])
  createdAt         DateTime @default(now())

  referentiels      AffaireReferentiel[]
  matieres          Matiere[]
  matieresPrevues   MatierePrevue[]
  joints            Joint[]
  fncs              FNC[]
  sequences         Sequence[]
  affectations      Affectation[]
  demandesSequencement DemandeModificationSequencement[]
  pieces            Piece[]
  photos            Photo[]
  pointsReglementaires PointReglementaire[]
  bilanIntervention BilanIntervention?
  diffusions        DiffusionRFI[]
  revisionsRapport  RevisionRFI[]
  perimetresTravaux PerimetreTravaux[]
  chronologie       EvenementChronologie[]
  bilanDosimetrique BilanDosimetrique?
  portiquesRadioprotection PortiqueRadioprotection[]
  pvExternes        PVExterne[]
  etatsDesLieux     EtatDesLieux[]
  documentsExternes DocumentExterne[]
  scansTqc          ScanTqc[]
  notesRex          NoteRex[]
}

// ============================================================================
// RAPPORT DE FIN D'INTERVENTION (RFI) — voir le modèle réel fourni par
// l'entreprise. Complète le rapport de fin de fabrication générique
// (dossierFinFabrication.ts) avec la structure précise attendue chez EDF :
// cartouche (entité, offre de service, accessibilité, diffusion,
// historique de révisions), travaux réalisés par intervenant, chronologie,
// bilan radioprotection, bilan global/REX. Les intitulés de section restent
// ceux du modèle fourni ; les valeurs elles-mêmes ne sont jamais préremplies
// avec des données réelles d'un chantier (confidentialité).
// ============================================================================

enum AccessibiliteDocument {
  LIBRE
  INTERNE
  LIMITEE
  CONFIDENTIELLE
}

// Contenu narratif propre au RFI, un par affaire. Rempli au fur et à
// mesure ; la trace des évolutions du document se fait via RevisionRFI
// (indice/date/nature des évolutions), pas par un historique séparé pour
// chaque champ ci-dessous — cohérent avec le fonctionnement d'un document
// Word réel à cartouche de révisions.
model BilanIntervention {
  id                     String    @id @default(cuid())
  affaire                Affaire   @relation(fields: [affaireId], references: [id])
  affaireId              String    @unique

  entiteEmettrice        String?
  referenceOffreService  String?
  accessibilite          AccessibiliteDocument?

  definitionIntervention String?
  rexPosesDeposes        String?
  ecartsTravauxPrevusRealises String?
  conformiteTravaux      String?

  bilanActionsRadioprotection String?
  analyseEcartsRadioprotectionAmelioration String?

  bonnesPratiques        String?
  dysfonctionnements     String?
  mesuresCorrectivesSuivantes String?
}

enum PorteeDiffusion {
  INTERNE
  EXTERNE
}

// Liste de diffusion du RFI (voir cartouche du modèle réel) : des noms et
// organismes en texte libre, pas forcément des fiches Personnel (souvent
// des destinataires externes au CNPE/à l'entreprise).
model DiffusionRFI {
  id        String          @id @default(cuid())
  affaire   Affaire         @relation(fields: [affaireId], references: [id])
  affaireId String
  portee    PorteeDiffusion
  nom       String
  organisme String?

  @@index([affaireId])
}

// Historique des révisions du RFI lui-même (indice/date/nature des
// évolutions/rédacteur(s)/vérificateur(s)/approbateur(s)) — un nouvel
// enregistrement à chaque évolution du document, jamais une modification
// du précédent.
model RevisionRFI {
  id               String   @id @default(cuid())
  affaire          Affaire  @relation(fields: [affaireId], references: [id])
  affaireId        String
  indice           String
  date             DateTime @default(now())
  natureEvolutions String
  redacteurs       String?
  verificateurs    String?
  approbateurs     String?
  createdAt        DateTime @default(now())

  @@index([affaireId])
}

// Qui a la charge de quels travaux (ex. "à la charge ULM", "à la charge
// des prestataires"...) — texte libre, l'intitulé des intervenants et le
// découpage des responsabilités dépendant entièrement du projet.
model PerimetreTravaux {
  id          String  @id @default(cuid())
  affaire     Affaire @relation(fields: [affaireId], references: [id])
  affaireId   String
  intervenant String
  description String
  ordre       Int     @default(0)

  @@index([affaireId])
}

// Chronologie de l'intervention (résumé, voir "6.1 Résumé de
// l'intervention" du modèle réel) : une ligne par événement notable, dans
// l'ordre où ils sont survenus.
model EvenementChronologie {
  id          String   @id @default(cuid())
  affaire     Affaire  @relation(fields: [affaireId], references: [id])
  affaireId   String
  date        DateTime
  description String

  @@index([affaireId])
}

// Bilan dosimétrique global de l'intervention (voir "Bilan radioprotection"
// du modèle réel) : un par affaire. Le détail par activité renvoie à
// l'outil de suivi dosimétrique externe de l'entreprise (CERAP ou
// équivalent), hors périmètre de Weldoc pour l'instant.
model BilanDosimetrique {
  id         String  @id @default(cuid())
  affaire    Affaire @relation(fields: [affaireId], references: [id])
  affaireId  String  @unique
  edpiMsv    Float?
  edpoMsv    Float?
  realiseMsv Float?
  deltaMsv   Float?
  alea       String?
}

// Relevés des portiques de contrôle radiologique en sortie de zone
// (catégories C1/C2/C3 du modèle réel — texte libre, pas de nomenclature
// imposée par Weldoc).
model PortiqueRadioprotection {
  id           String  @id @default(cuid())
  affaire      Affaire @relation(fields: [affaireId], references: [id])
  affaireId    String
  categorie    String
  nombre       Int
  localisation String?
  observations String?

  @@index([affaireId])
}

model Referentiel {
  id          String  @id @default(cuid())
  code        String  @unique
  domaine     String
  version     String?
  affaires    AffaireReferentiel[]
  qualifications Qualification[]
  produitsDimensionnels ProduitDimensionnel[]
}

model AffaireReferentiel {
  id            String      @id @default(cuid())
  affaire       Affaire     @relation(fields: [affaireId], references: [id])
  affaireId     String
  referentiel   Referentiel @relation(fields: [referentielId], references: [id])
  referentielId String

  @@unique([affaireId, referentielId])
}

model Sequence {
  id         String   @id @default(cuid())
  affaire    Affaire  @relation(fields: [affaireId], references: [id])
  affaireId  String
  ordre      Int
  nom        String
  phases     Phase[]
}

enum StatutPhase {
  A_FAIRE
  EN_COURS
  TERMINEE
  NON_APPLICABLE
}

model Phase {
  id           String      @id @default(cuid())
  sequence     Sequence    @relation(fields: [sequenceId], references: [id])
  sequenceId   String
  ordre        Int
  nom          String
  obligatoire  Boolean     @default(true)
  statut       StatutPhase @default(A_FAIRE)
  justificationNA String?
  // Procédure/instruction/formulaire/PV/fiche technique applicable (voir
  // le cahier des charges, "DOCUMENTATION ET PROCÉDURES INTERNES") : un
  // lien vers une révision précise de la bibliothèque ProcedureInterne, ce
  // qui conserve automatiquement "la version réellement utilisée à
  // l'exécution" — une révision n'y est jamais modifiée après coup (même
  // principe que WPS/QMOS), donc ce lien suffit, pas besoin d'un
  // historique séparé.
  procedureInterne   ProcedureInterne? @relation(fields: [procedureInterneId], references: [id])
  procedureInterneId String?
  photos       Photo[]
  pointsReglementaires PointReglementaire[]
  pvExternes   PVExterne[]
  documentsExternes DocumentExterne[]
  // Référence libre vers Signature.id (documentType "PHASE"), comme
  // signatureId ailleurs dans le modèle — voir POST /api/phases/signer :
  // l'exécutant sélectionne les phases réalisées et s'identifie une seule
  // fois (QR/matricule + PIN), ce qui vaut signature pour chacune d'elles
  // et les passe TERMINEE.
  signatureId  String?
}

model Matiere {
  id             String   @id @default(cuid())
  affaire        Affaire  @relation(fields: [affaireId], references: [id])
  affaireId      String
  fournisseur    String
  designation    String
  reference      String?
  normeProduit   String
  nuance         String
  diametre       Float?
  epaisseur      Float?
  finition       String?
  etat           String?
  numeroCoulee   String
  numeroLot      String?
  ccpuDocumentUrl String?
  certificatUrl  String?

  joints         Joint[]

  @@index([numeroCoulee])
}

// Ce qui est commandé/prévu pour l'affaire (norme produit, nuance,
// diamètre/épaisseur), saisi une seule fois par l'encadrement, puis
// comparé automatiquement à chaque matière réceptionnée (voir
// src/lib/conformiteMatiere.ts) pour signaler un écart avant que la
// matière ne soit mise en œuvre. Comme pour l'affectation adaptée,
// Weldoc ne bloque jamais la réception : les alertes restent
// indicatives, la décision reste humaine et tracée si elle passe outre.
model MatierePrevue {
  id             String   @id @default(cuid())
  affaire        Affaire  @relation(fields: [affaireId], references: [id])
  affaireId      String
  designation    String
  normeProduit   String
  nuance         String
  diametre       Float?
  epaisseur      Float?
  quantitePrevue String?
  createdAt      DateTime @default(now())
}

model Joint {
  id              String   @id @default(cuid())
  numero          String
  affaire         Affaire  @relation(fields: [affaireId], references: [id])
  affaireId       String
  ligne           String?
  spool           String?
  typeJoint       String?
  dn              String?
  diametre        Float?
  epaisseur       Float?
  matiere         Matiere? @relation(fields: [matiereId], references: [id])
  matiereId       String?
  // Pièce d'atelier que ce joint concerne (voir le cahier des charges,
  // fabrication en atelier), optionnel — une affaire "chantier" n'a
  // jamais de pièce à lier. Permet à une pièce prise en charge de suivre
  // les joints/contrôles qui la concernent au fil de la fabrication,
  // plutôt que de rester un objet indépendant sans lien.
  piece           Piece?   @relation(fields: [pieceId], references: [id])
  pieceId         String?
  // wpsReference/qmosReference restent en texte libre pour les cas non
  // encore couverts par la bibliothèque (voir Wps/Qmos ci-dessous) ; wpsId/
  // qmosId sont le lien structuré vers une fiche réutilisable quand elle
  // existe — les deux peuvent coexister le temps que la bibliothèque se
  // remplisse.
  wpsReference    String?
  wps             Wps?     @relation(fields: [wpsId], references: [id])
  wpsId           String?
  qmosReference   String?
  qmos            Qmos?    @relation(fields: [qmosId], references: [id])
  qmosId          String?
  qsReference     String?
  soudeur         Personnel? @relation("Soudeur", fields: [soudeurId], references: [id])
  soudeurId       String?
  consommableLot  String?

  jointParent     Joint?   @relation("Reparations", fields: [jointParentId], references: [id])
  jointParentId   String?
  reparations     Joint[]  @relation("Reparations")
  indiceReparation Int     @default(0)
  // Nature de l'action de remise en conformité pour ce joint, quand c'est
  // une réparation (null pour un joint d'origine, indiceReparation 0).
  typeAction      TypeActionRemiseEnConformite?

  // Une fiche technique de suivi de soudage peut couvrir plusieurs joints
  // à la fois (voir FicheTechniqueSoudage ci-dessous : "saisie groupée",
  // quand le même soudeur a réalisé plusieurs soudures avec les mêmes
  // paramètres) — un joint n'appartient jamais qu'à une seule fiche.
  ficheSoudage    FicheTechniqueSoudage? @relation(fields: [ficheSoudageId], references: [id])
  ficheSoudageId  String?
  tqc             TQC?
  controlesDim    ControleDimensionnel[]
  controlesVisuels ControleVisuel[]
  controlesRessuage ControleRessuage[]
  controlesMagnetoscopie ControleMagnetoscopie[]
  controlesRadiographie  ControleRadiographie[]
  controlesUltrasons     ControleUltrasons[]
  fncs            FNC[]
  // FNC dont CE joint (une réparation) est l'action corrective — distinct
  // de `fncs`, qui liste les FNC ouvertes SUR ce joint.
  fncsResolues    FNC[]    @relation("ActionCorrectiveFNC")
  affectations    Affectation[]
  photos          Photo[]
  pointsReglementaires PointReglementaire[]
  pvExternes      PVExterne[]
  documentsExternes DocumentExterne[]
  scansTqc        ScanTqc[]

  @@unique([affaireId, numero, indiceReparation])
  @@index([affaireId])
}

// Fiche de suivi de soudage (voir le cahier des charges, "FICHE TECHNIQUE
// DE SUIVI DE SOUDAGE" : "un exemple réel sera intégré ultérieurement pour
// finaliser tous les champs" — les champs ci-dessous restent donc une
// première version). L'identification du joint/soudeur/QS/WPS/QMOS/
// consommable/diamètre/épaisseur n'est jamais redemandée ici : elle vient
// déjà de Joint. Une même fiche peut couvrir plusieurs joints (`joints`)
// quand le même soudeur a réalisé plusieurs soudures avec les mêmes
// paramètres dans la même période ("saisie groupée", voir le cahier des
// charges, PRINCIPE CENTRAL : "une donnée saisie une seule fois") — un
// joint n'appartient jamais qu'à une seule fiche à la fois. Modifiable
// (champs, et joints couverts) tant qu'elle n'est pas signée
// (voir POST/PATCH /api/fiches-soudage) ; une fois signée, plus aucune
// modification n'est acceptée — la signature atteste des valeurs finales
// pour l'ensemble des joints couverts.
model FicheTechniqueSoudage {
  id                    String   @id @default(cuid())
  joints                Joint[]
  procede               String?
  preechauffageC        Float?
  temperatureInterpasses Float?
  postchauffageC        Float?
  tensionV              Float?
  intensiteA            Float?
  vitesseMmMin          Float?
  energieKJMm           Float?
  nombrePasses          Int?
  tempsMin              Float?
  observations          String?
  photosUrls            String[]
  signatureId           String?
}

// TQC — "tel que construit" (voir le cahier des charges) : localisation
// des soudures, équipement/support concerné, écarts et observations par
// rapport au prévu. Les dimensions mesurées et les photos ne sont jamais
// dupliquées ici : elles restent sur le contrôle dimensionnel et le book
// photo du joint (déjà liables via Photo.jointId), qui font foi. Version
// "ISO manuel" du cahier des charges (trois méthodes combinables prévues :
// ISO manuel, scan 3D, book photo) — le scan 3D reste une fonction
// complémentaire non obligatoire, hors périmètre pour l'instant. Modifiable
// tant que non signé (POST /api/joints/[id]/tqc), même principe que la
// fiche technique de suivi de soudage.
model TQC {
  id           String  @id @default(cuid())
  joint        Joint   @relation(fields: [jointId], references: [id])
  jointId      String  @unique
  localisation String?
  equipement   String?
  support      String?
  ecarts       String?
  observations String?
  // ISO manuel sur tablette (troisième méthode du TQC, voir le cahier des
  // charges) : annotation graphique à main levée (stylet, doigt ou
  // souris) par-dessus un fond optionnel déjà hébergé (schéma iso). Les
  // traits sont conservés comme des tracés vectoriels (liste de points en
  // coordonnées relatives 0..1, indépendantes de la taille d'écran) —
  // jamais une image figée — pour rester modifiables comme le reste du
  // TQC tant qu'il n'est pas signé. Voir IsoTrait dans
  // src/app/joints/iso-canvas.tsx pour la forme exacte du JSON.
  isoFondUrl   String?
  isoTraits    Json?
  signatureId  String?
}

// Scan 3D (voir le cahier des charges, "TQC (TEL QUE CONSTRUIT)" >
// "Scan 3D") : deuxième des trois méthodes du TQC, complémentaire et non
// obligatoire. Ne conserve que la trace du scan externe — fichier source,
// date, opérateur, zone couverte, logiciel/version, fichier généré et
// document ISO/TQC qui en résulte — même principe que les CCPU et PV
// externes déjà en place : un lien vers un fichier déjà hébergé, pas un
// téléversement direct dans Weldoc. Une zone peut couvrir plusieurs joints
// à la fois (`joints`), sans jamais redemander leurs dimensions ou leurs
// photos, déjà saisies ailleurs. Comme un état des lieux ou un document
// externe : un nouveau scan de la même zone est un nouvel enregistrement,
// jamais une modification du précédent — pas de PATCH sur ce modèle.
model ScanTqc {
  id               String    @id @default(cuid())
  affaire          Affaire   @relation(fields: [affaireId], references: [id])
  affaireId        String
  zone             String
  dateScan         DateTime
  operateur        Personnel @relation("OperateurScanTqc", fields: [operateurId], references: [id])
  operateurId      String
  logiciel         String?
  versionLogiciel  String?
  fichierSourceUrl String
  fichierGenereUrl String?
  isoResultantUrl  String?
  createdAt        DateTime  @default(now())

  joints           Joint[]

  @@index([affaireId])
}

enum StatutOutil {
  VALIDE
  EXPIRE
  HORS_SERVICE
}

model Outil {
  id              String      @id @default(cuid())
  reference       String      @unique
  type            String
  fabricant       String?
  numeroSerie     String?
  dateVerification DateTime?
  dateEcheance    DateTime?
  statut          StatutOutil @default(VALIDE)
  certificatUrl   String?
  qrCodeValeur    String      @unique

  controles       ControleDimensionnel[]
  controlesMagnetoscopie ControleMagnetoscopie[]
  controlesRadiographie  ControleRadiographie[]
  controlesUltrasons     ControleUltrasons[]
  documentsExternes DocumentExterne[]
}

enum ResultatConformite {
  CONFORME
  HORS_TOLERANCE
  A_VERIFIER
}

model ControleDimensionnel {
  id             String              @id @default(cuid())
  joint          Joint               @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel           @relation("Controleur", fields: [controleurId], references: [id])
  controleurId   String
  outil          Outil?              @relation(fields: [outilId], references: [id])
  outilId        String?
  // Produit de la bibliothèque dimensionnelle utilisé, quand il y en a un
  // (voir ProduitDimensionnel ci-dessous) — sinon les critères viennent du
  // moteur de tolérances placeholder (src/lib/tolerances.ts). Dans les
  // deux cas, `criteresAppliques` garde une copie des critères réellement
  // appliqués au moment du contrôle (jamais recalculée après coup).
  produitDimensionnel   ProduitDimensionnel? @relation(fields: [produitDimensionnelId], references: [id])
  produitDimensionnelId String?
  dateControle   DateTime            @default(now())
  mesures        Json
  criteresAppliques Json
  resultat       ResultatConformite
  signatureId    String?

  fncsGenerees   FNC[]
}

// Bibliothèque dimensionnelle (voir le cahier des charges, "BIBLIOTHÈQUE
// DIMENSIONNELLE") : produits normalisés (tubes, tôles, raccords,
// brides...) avec leurs critères dimensionnels déjà déterminés par une
// personne compétente à partir de la norme réelle — jamais recalculés par
// une formule Weldoc, contrairement au moteur placeholder de
// src/lib/tolerances.ts (que cette bibliothèque vise à terme à
// remplacer, référence par référence, à mesure qu'elle se remplit). Même
// principe de versionnage que WPS/QMOS/ProcedureInterne/DocumentExterne :
// une nouvelle révision (norme mise à jour) est un nouvel enregistrement.
model ProduitDimensionnel {
  id                  String   @id @default(cuid())
  reference           String
  version             String   @default("Rev 0")
  designation         String
  type                String?
  normeProduit        String
  diametreNominalMm   Float?
  epaisseurNominaleMm Float?
  finition            String?
  etat                String?
  classeType          String?
  diametreMiniMm      Float
  diametreMaxiMm      Float
  epaisseurMiniMm     Float
  epaisseurMaxiMm     Float
  referentiel         Referentiel? @relation(fields: [referentielId], references: [id])
  referentielId       String?
  retiree             Boolean  @default(false)
  createdAt           DateTime @default(now())

  controles           ControleDimensionnel[]

  @@index([reference])
}

// ============================================================================
// CONTRÔLE VISUEL ET CND (VT, PT/ressuage — MT/RT/UT à construire de la même
// façon, module par module)
// ============================================================================
// Résultat générique conforme/non conforme/à vérifier, distinct de
// ResultatConformite (propre aux tolérances dimensionnelles) car les termes
// n'ont pas le même sens pour une indication visuelle ou CND.
enum ResultatControle {
  CONFORME
  NON_CONFORME
  A_VERIFIER
}

// Les 6 champs numeroPV.../moyensUtilises ci-dessous (et sur les 4 autres
// méthodes de contrôle plus bas) sont propres au procès-verbal lui-même,
// distincts de ce qui est déjà tracé ailleurs (type de joint, diamètre,
// épaisseur, matière restent sur Joint ; jamais redemandés ici, voir le
// PRINCIPE CENTRAL du cahier des charges). Tous facultatifs et en texte
// libre : leurs valeurs possibles dépendent du référentiel de l'entreprise,
// jamais imposées par Weldoc.
model ControleVisuel {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurVisuel", fields: [controleurId], references: [id])
  controleurId   String
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  // Indications : localisation, nature, dimensions, critère applicable,
  // conforme (bool), commentaire, photoUrl — une indication conforme reste
  // documentée, elle ne signifie pas automatiquement une non-conformité.
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  controlesRessuagePrealable ControleRessuage[]
  fncsGenerees   FNC[]

  @@index([jointId])
}

enum TypeConsommableCND {
  // Ressuage (PT)
  PENETRANT
  REVELATEUR
  NETTOYANT
  // Magnétoscopie (MT)
  POUDRE_MAGNETIQUE
  PRODUIT_CONTRASTE
  DEMAGNETISANT
  // Radiographie (RT)
  FILM_RADIOGRAPHIQUE
  PRODUIT_DEVELOPPEMENT
  // Ultrasons (UT)
  COUPLANT
  // Autre produit non listé ci-dessus
  AUTRE
}

// Bibliothèque des consommables CND : un produit/lot est enregistré une
// seule fois puis réutilisé sur chaque PV qui l'a employé, plutôt que
// ressaisi à chaque contrôle.
model ConsommableCND {
  id            String             @id @default(cuid())
  type          TypeConsommableCND
  fabricant     String
  reference     String
  lot           String
  peremption    DateTime?
  certificatUrl String?

  utilisationsRessuage      ControleRessuageConsommable[]
  utilisationsMagnetoscopie ControleMagnetoscopieConsommable[]
  utilisationsRadiographie  ControleRadiographieConsommable[]
  utilisationsUltrasons     ControleUltrasonsConsommable[]

  @@unique([type, fabricant, reference, lot])
}

model ControleRessuage {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurRessuage", fields: [controleurId], references: [id])
  controleurId   String
  // Le contrôle visuel préalable est obligatoire : on ne fait pas de
  // ressuage sur un joint dont l'état de surface n'a pas été vérifié.
  controleVisuelPrealable   ControleVisuel @relation(fields: [controleVisuelPrealableId], references: [id])
  controleVisuelPrealableId String
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  consommables   ControleRessuageConsommable[]
  fncsGenerees   FNC[]

  @@index([jointId])
}

model ControleRessuageConsommable {
  id                 String           @id @default(cuid())
  controleRessuage   ControleRessuage @relation(fields: [controleRessuageId], references: [id])
  controleRessuageId String
  consommable        ConsommableCND   @relation(fields: [consommableId], references: [id])
  consommableId      String

  @@unique([controleRessuageId, consommableId])
}

// MT/RT/UT : même structure que le contrôle visuel (indications en JSON,
// résultat déduit des indications, FNC automatique si non conforme), et
// comme le ressuage, un lien optionnel vers les consommables utilisés
// (bibliothèque commune ConsommableCND, jamais ressaisis).
model ControleMagnetoscopie {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurMagnetoscopie", fields: [controleurId], references: [id])
  controleurId   String
  // Équipement/banc utilisé (bibliothèque métrologie/outillage partagée
  // avec le contrôle dimensionnel — voir Outil) : un outil expiré ou hors
  // service bloque le contrôle, comme pour le contrôle dimensionnel.
  outil          Outil?            @relation(fields: [outilId], references: [id])
  outilId        String?
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  consommables   ControleMagnetoscopieConsommable[]
  fncsGenerees   FNC[]

  @@index([jointId])
}

model ControleMagnetoscopieConsommable {
  id                      String                @id @default(cuid())
  controleMagnetoscopie   ControleMagnetoscopie @relation(fields: [controleMagnetoscopieId], references: [id])
  controleMagnetoscopieId String
  consommable             ConsommableCND        @relation(fields: [consommableId], references: [id])
  consommableId           String

  @@unique([controleMagnetoscopieId, consommableId])
}

model ControleRadiographie {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurRadiographie", fields: [controleurId], references: [id])
  controleurId   String
  // Appareil/source radiographique utilisé (voir Outil, même bibliothèque
  // que le contrôle dimensionnel) : un outil expiré ou hors service
  // bloque le contrôle.
  outil          Outil?            @relation(fields: [outilId], references: [id])
  outilId        String?
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  consommables   ControleRadiographieConsommable[]
  fncsGenerees   FNC[]

  @@index([jointId])
}

model ControleRadiographieConsommable {
  id                     String               @id @default(cuid())
  controleRadiographie   ControleRadiographie @relation(fields: [controleRadiographieId], references: [id])
  controleRadiographieId String
  consommable            ConsommableCND       @relation(fields: [consommableId], references: [id])
  consommableId          String

  @@unique([controleRadiographieId, consommableId])
