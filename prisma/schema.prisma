model ControleUltrasons {
  id             String            @id @default(cuid())
  joint          Joint             @relation(fields: [jointId], references: [id])
  jointId        String
  controleur     Personnel         @relation("ControleurUltrasons", fields: [controleurId], references: [id])
  controleurId   String
  // Appareil ultrasons utilisé (voir Outil, même bibliothèque que le
  // contrôle dimensionnel) : un outil expiré ou hors service bloque le
  // contrôle.
  outil          Outil?            @relation(fields: [outilId], references: [id])
  outilId        String?
  procedureRef   String
  procedureVersion String?
  numeroPV       String?
  referentielAcceptation String?
  editionReferentiel     String?
  categorieConstruction  String?
  niveauExamen           String?
  methodeExamen          String?
  surfacesExaminees      String?
  etatSurface            String?
  eclairage              String?
  moyensUtilises         String?
  dateControle   DateTime          @default(now())
  indications    Json
  resultat       ResultatControle
  signatureId    String?

  consommables   ControleUltrasonsConsommable[]
  fncsGenerees   FNC[]

  @@index([jointId])
}

model ControleUltrasonsConsommable {
  id                  String            @id @default(cuid())
  controleUltrasons   ControleUltrasons @relation(fields: [controleUltrasonsId], references: [id])
  controleUltrasonsId String
  consommable         ConsommableCND    @relation(fields: [consommableId], references: [id])
  consommableId       String

  @@unique([controleUltrasonsId, consommableId])
}

enum StatutFNC {
  DETECTION
  ANALYSE
  ACTION_CORRECTIVE
  CONTROLE
  VALIDATION
  CLOTUREE
}

enum ImpactFNC {
  BLOQUANTE
  NON_BLOQUANTE
  REGLEMENTAIREMENT_SENSIBLE
}

model FNC {
  id                String    @id @default(cuid())
  reference         String    @unique
  affaire           Affaire   @relation(fields: [affaireId], references: [id])
  affaireId         String
  joint             Joint?    @relation(fields: [jointId], references: [id])
  jointId           String?
  controleOrigine   ControleDimensionnel? @relation(fields: [controleOrigineId], references: [id])
  controleOrigineId String?
  // Une FNC ne peut avoir qu'une seule origine parmi les contrôles
  // ci-dessous. Un champ par type de contrôle plutôt qu'une relation
  // polymorphe unique, pour rester cohérent avec controleOrigine ci-dessus ;
  // à revoir si le nombre de méthodes CND grandit encore.
  controleVisuelOrigine   ControleVisuel? @relation(fields: [controleVisuelOrigineId], references: [id])
  controleVisuelOrigineId String?
  controleRessuageOrigine   ControleRessuage? @relation(fields: [controleRessuageOrigineId], references: [id])
  controleRessuageOrigineId String?
  controleMagnetoscopieOrigine   ControleMagnetoscopie? @relation(fields: [controleMagnetoscopieOrigineId], references: [id])
  controleMagnetoscopieOrigineId String?
  controleRadiographieOrigine    ControleRadiographie?  @relation(fields: [controleRadiographieOrigineId], references: [id])
  controleRadiographieOrigineId  String?
  controleUltrasonsOrigine       ControleUltrasons?     @relation(fields: [controleUltrasonsOrigineId], references: [id])
  controleUltrasonsOrigineId     String?
  description       String
  impact            ImpactFNC
  statut            StatutFNC @default(DETECTION)
  actionCorrective  String?
  // Le joint de réparation qui constitue l'action corrective de cette FNC
  // (voir POST /api/joints/[id]/reparation). Distinct de `joint` ci-dessus,
  // qui est le joint sur lequel la FNC a été détectée.
  actionCorrectiveJoint   Joint?    @relation("ActionCorrectiveFNC", fields: [actionCorrectiveJointId], references: [id])
  actionCorrectiveJointId String?
  dateCreation      DateTime  @default(now())
  dateCloture       DateTime?
  valideeParId      String?
  photos            Photo[]
  documentsExternes DocumentExterne[]
  rex               FicheREX?
}

// Retour d'expérience (voir le cahier des charges, "RETOUR D'EXPÉRIENCE
// (REX)") : une fiche de synthèse par FNC, rédigée une fois la cause
// comprise et une solution mise en œuvre. Le classement par matériau/
// procédé/fournisseur/type de joint/chantier n'est jamais dupliqué ici :
// il se lit déjà sur le joint et l'affaire de la FNC (Joint.matiere,
// Joint.wps, Affaire.chantier...), consultés à la lecture sur
// /rex. "Identification de problématiques similaires" reste explicitement
// "à terme" au cahier des charges — pas construit ici : l'IA n'assiste
// pas encore cette recherche, seul le classement manuel par type de
// problème permet de repérer des cas proches.
model FicheREX {
  id            String    @id @default(cuid())
  fnc           FNC       @relation(fields: [fncId], references: [id])
  fncId         String    @unique
  typeProbleme  String
  origine       String?
  cause         String
  solution      String
  resultat      String?
  redacteur     Personnel @relation(fields: [redacteurId], references: [id])
  redacteurId   String
  dateRedaction DateTime  @default(now())

  @@index([typeProbleme])
}

// Notes REX (voir le cahier des charges, "RETOUR D'EXPÉRIENCE (REX)") :
// contrairement à FicheREX (une fiche par FNC, rédigée après coup à la
// clôture), une note se prend à tout moment de l'affaire, par n'importe
// quel intervenant, sans attendre qu'une FNC existe — une observation sur
// un fournisseur, une matière, une méthode qui pose question... Alimente
// le REX progressivement plutôt que tout d'un coup à la fin ; jamais
// modifiée ni supprimée une fois postée (comme un constat), seulement
// consultée au moment de rédiger une fiche REX.
model NoteRex {
  id        String    @id @default(cuid())
  affaire   Affaire   @relation(fields: [affaireId], references: [id])
  affaireId String
  texte     String
  auteur    Personnel @relation("AuteurNoteRex", fields: [auteurId], references: [id])
  auteurId  String
  createdAt DateTime  @default(now())

  @@index([affaireId])
}

// Book photo (voir le cahier des charges) : photos horodatées rattachées à
// une affaire et, optionnellement, à une phase/un joint/une FNC précis —
// utilisées pour la prise en charge, le suivi, les contrôles, les FNC, le
// TQC et la restitution. `url` reste du texte libre pour l'instant : pas
// encore de téléversement de fichier intégré à Weldoc (comme
// `FicheTechniqueSoudage.photosUrls`/`Piece.photosUrls` ailleurs dans le
// modèle) — une vraie prise en charge de fichiers suppose de choisir un
// hébergeur, à discuter avec l'entreprise avant de s'engager sur un coût
// récurrent.
model Photo {
  id          String    @id @default(cuid())
  affaire     Affaire   @relation(fields: [affaireId], references: [id])
  affaireId   String
  phase       Phase?    @relation(fields: [phaseId], references: [id])
  phaseId     String?
  joint       Joint?    @relation(fields: [jointId], references: [id])
  jointId     String?
  fnc         FNC?      @relation(fields: [fncId], references: [id])
  fncId       String?
  etatDesLieux   EtatDesLieux? @relation(fields: [etatDesLieuxId], references: [id])
  etatDesLieuxId String?
  url         String
  commentaire String?
  auteur      Personnel @relation("AuteurPhoto", fields: [auteurId], references: [id])
  auteurId    String
  dateAjout   DateTime  @default(now())

  @@index([affaireId])
  @@index([jointId])
  @@index([etatDesLieuxId])
}

// Dossier réglementaire (voir le cahier des charges, "DOSSIER
// RÉGLEMENTAIRE" / "Blocage réglementaire") : distinct du rapport de fin
// de fabrication (compilation globale, voir dossierFinFabrication.ts) —
// ici, chaque exigence réglementaire (ex. "Attestation de conformité OHA",
// "Note d'optimisation de la radioprotection"...) est suivie une par une,
// avec un statut qui peut évoluer. L'intitulé et le référentiel restent en
// texte libre : leur liste dépend entièrement du projet/référentiel client
// (RCC-M, CODAP...), jamais imposée par Weldoc. Rattaché à l'affaire et,
// optionnellement, à un joint ou une phase précis (sinon il concerne
// l'affaire dans son ensemble).
model PointReglementaire {
  id          String    @id @default(cuid())
  affaire     Affaire   @relation(fields: [affaireId], references: [id])
  affaireId   String
  joint       Joint?    @relation(fields: [jointId], references: [id])
  jointId     String?
  phase       Phase?    @relation(fields: [phaseId], references: [id])
  phaseId     String?
  intitule    String
  // Règle/référentiel dont dépend ce point (traçabilité exigée au cahier
  // des charges, "PRINCIPE DE CONCEPTION") — texte libre, jamais une norme
  // recopiée.
  referentiel String?
  createdAt   DateTime  @default(now())

  evenements  PointReglementaireEvenement[]

  @@index([affaireId])
}

// Les 5 statuts prévus au cahier des charges. Le statut "actuel" d'un
// point n'est jamais stocké directement sur PointReglementaire : c'est
// toujours le dernier événement de son historique (même principe que les
// qualifications, QualificationEvenement) — un changement de statut est un
// nouvel enregistrement, jamais une modification du précédent.
enum StatutPointReglementaire {
  NON_BLOQUANT
  BLOQUANT
  SOUS_RESERVE
  ATTENTE_DECISION
  DEBLOCAGE_AUTORISE
}

model PointReglementaireEvenement {
  id                   String                   @id @default(cuid())
  pointReglementaire   PointReglementaire       @relation(fields: [pointReglementaireId], references: [id])
  pointReglementaireId String
  statut               StatutPointReglementaire
  commentaire          String?
  auteur               Personnel                @relation(fields: [auteurId], references: [id])
  auteurId             String
  // Signature du déblocage (voir POST /api/signatures, documentType
  // "POINT_REGLEMENTAIRE") : réservée aux passages en DEBLOCAGE_AUTORISE,
  // qui exigent aussi le niveau 3 côté serveur — l'IA ne décide jamais
  // seule qu'un point bloquant peut être levé.
  signatureId          String?
  date                 DateTime                 @default(now())

  @@index([pointReglementaireId])
}

// PV externes (voir le cahier des charges, "PV EXTERNES") : documents
// produits par un prestataire externe (rapport de CND sous-traité,
// certificat d'étalonnage, PV d'ouverture/fermeture de chantier...),
// importés et liés à une affaire et, optionnellement, à un joint ou une
// phase précis. `url` reste du texte libre pour l'instant, comme les
// autres pièces jointes de l'application — pas de téléversement de
// fichier intégré à Weldoc (voir Photo). La revue (qui, quand, conforme
// ou non) n'est jamais modifiée une fois faite : un document corrigé se
// réimporte comme un nouveau PVExterne, jamais en écrasant l'ancien.
enum ConclusionRevuePVExterne {
  CONFORME
  NON_CONFORME
}

model PVExterne {
  id           String    @id @default(cuid())
  affaire      Affaire   @relation(fields: [affaireId], references: [id])
  affaireId    String
  joint        Joint?    @relation(fields: [jointId], references: [id])
  jointId      String?
  phase        Phase?    @relation(fields: [phaseId], references: [id])
  phaseId      String?
  intitule     String
  prestataire  String?
  url          String
  dateDocument DateTime?
  importePar   Personnel @relation("ImporteurPVExterne", fields: [importeParId], references: [id])
  importeParId String
  dateImport   DateTime  @default(now())

  // Revue tracée par une personne habilitée (cahier des charges : "niveau
  // 3 si requis" — Weldoc l'exige systématiquement, pour rester simple et
  // sûr par défaut). Les trois champs se remplissent ensemble, une seule
  // fois.
  revueConclusion  ConclusionRevuePVExterne?
  revueCommentaire String?
  revuePar         Personnel? @relation("ReviseurPVExterne", fields: [revueParId], references: [id])
  revueParId       String?
  dateRevue        DateTime?

  @@index([affaireId])
  @@index([jointId])
}

// Documents externes et bibliothèque documentaire (voir le cahier des
// charges, "DOCUMENTS EXTERNES ET BIBLIOTHÈQUE DOCUMENTAIRE") : documents
// de fournisseurs/sous-traitants/prestataires CND ou traitement
// thermique/organismes externes. Distinct de PVExterne (toujours rattaché
// à UNE affaire) : ici un même document peut se relier à plusieurs
// affaires/joints/phases/FNC/personnel/équipements à la fois — "un
// document n'est jamais téléchargé plusieurs fois pour plusieurs usages".
// Même principe de versionnage que WPS/QMOS/ProcedureInterne
// (`annoterStatutProcedures`, réutilisée telle quelle) : une nouvelle
// révision est un nouvel enregistrement, jamais une modification de la
// précédente. La validation réutilise `ConclusionRevuePVExterne` (même
// forme conforme/non conforme) plutôt qu'un nouvel enum équivalent.
model DocumentExterne {
  id           String    @id @default(cuid())
  reference    String
  version      String    @default("Rev 0")
  titre        String
  categorie    String?
  url          String
  dateDocument DateTime?
  importePar   Personnel @relation("ImporteurDocumentExterne", fields: [importeParId], references: [id])
  importeParId String
  dateImport   DateTime  @default(now())

  valideConclusion  ConclusionRevuePVExterne?
  valideCommentaire String?
  validePar         Personnel? @relation("ValidateurDocumentExterne", fields: [valideParId], references: [id])
  valideParId       String?
  dateValidation    DateTime?

  retiree      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  affaires     Affaire[]
  joints       Joint[]
  phases       Phase[]
  fncs         FNC[]
  personnel    Personnel[] @relation("PersonnelConcerneDocumentExterne")
  outils       Outil[]

  @@index([reference])
}

// Prise en charge / restitution du chantier (voir le cahier des charges,
// "PRISE EN CHARGE ET RESTITUTION DU CHANTIER") : un état des lieux en
// début d'intervention, un autre en fin — jamais le même enregistrement
// modifié en place (un nouveau constat, même type, reste un nouvel
// EtatDesLieux ; le plus récent de chaque type fait foi). La comparaison
// avant/après (photos, observations) se fait à la lecture en
// rapprochant le dernier PRISE_EN_CHARGE et le dernier RESTITUTION d'une
// affaire — rien à stocker en plus pour ça.
enum TypeEtatDesLieux {
  PRISE_EN_CHARGE
  RESTITUTION
}

model EtatDesLieux {
  id            String           @id @default(cuid())
  affaire       Affaire          @relation(fields: [affaireId], references: [id])
  affaireId     String
  type          TypeEtatDesLieux
  zone          String?
  redacteur     Personnel        @relation(fields: [redacteurId], references: [id])
  redacteurId   String
  dateConstat   DateTime         @default(now())

  observations           String?
  degradationsConstatees String?
  documentsEntree        String?

  // Modifiable (constat + réserves) tant que non signé ; une fois
  // signatureId renseigné, plus aucune modification n'est acceptée — même
  // principe que la fiche technique de suivi de soudage.
  signatureId   String?

  photos        Photo[]
  reserves      ReserveConstat[]

  @@index([affaireId])
}

// Une réserve, une fiche d'aléa ou une FNC (cahier des charges : "en cas
// de problème") : ici, la réserve simple, transmissible au client. Un
// problème plus grave se déclare comme FNC via le module FNC déjà
// existant (en la reliant à la même affaire) plutôt que de dupliquer ce
// workflow ici.
model ReserveConstat {
  id                String       @id @default(cuid())
  etatDesLieux      EtatDesLieux @relation(fields: [etatDesLieuxId], references: [id])
  etatDesLieuxId    String
  description       String
  transmiseAuClient Boolean      @default(false)
  dateAjout         DateTime     @default(now())

  @@index([etatDesLieuxId])
}

// Actions possibles de remise en conformité, comme listées au cahier des
// charges.
enum TypeActionRemiseEnConformite {
  REPARATION
  MEULAGE
  RESURFACAGE
  REPRISE
  REMPLACEMENT
  CONTROLE_COMPLEMENTAIRE
}

// Une signature n'est produite qu'au bout du parcours demandé au cahier des
// charges : identification (QR ou matricule) → authentification (PIN,
// haché comme un mot de passe — voir Personnel.pinHash) → vérification que
// la charte en vigueur a été acceptée → création de cet enregistrement
// (horodatage automatique). Voir POST /api/signatures. `documentType`/
// `documentId` restent génériques (pas de clé étrangère) car une signature
// peut porter sur n'importe quel type de document (contrôle, fiche de
// soudage, événement de qualification...) ; chaque table qui peut être
// signée porte son propre `signatureId` en texte libre, jamais une relation
// directe vers ce modèle.
model Signature {
  id             String    @id @default(cuid())
  personnel      Personnel @relation(fields: [personnelId], references: [id])
  personnelId    String
  documentType   String
  documentId     String
  dateSignature  DateTime  @default(now())
  versionDocument String

  @@index([documentType, documentId])
}

// Autorisations de signature (voir le cahier des charges, fiche personne :
// "autorisations, ... autorisations de signature" ; et "IDENTIFICATION ET
// SIGNATURE" : "contrôle des droits" fait partie du parcours de signature,
// après l'identification et le PIN, avant la signature elle-même). Permet
// de nommer explicitement qui a le droit de signer un type de document
// donné (`documentType`, la même valeur que Signature.documentType),
// au-delà du simple niveau. N'agit que si au moins une autorisation
// existe pour ce documentType : tant qu'aucune n'est configurée, le
// contrôle d'accès déjà en place (niveau, sur chaque route) continue de
// s'appliquer sans changement — voir src/lib/autorisationsSignature.ts.
// Révoquer une autorisation ne supprime jamais la ligne : `active`
// repasse à false et le changement est tracé par l'audit trail, comme le
// niveau d'une personne ou le statut d'un compte.
model AutorisationSignature {
  id            String    @id @default(cuid())
  personnel     Personnel @relation(fields: [personnelId], references: [id])
  personnelId   String
  documentType  String
  active        Boolean   @default(true)
  accordeePar   Personnel @relation("AccordeParAutorisationSignature", fields: [accordeeParId], references: [id])
  accordeeParId String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([personnelId, documentType])
  @@index([documentType])
}

model AuditTrail {
  id            String   @id @default(cuid())
  utilisateurId String
  date          DateTime @default(now())
  entite        String
  entiteId      String
  ancienneValeur Json?
  nouvelleValeur Json?
  motif         String?
}

// ============================================================================
// PLANNING ET ORGANIGRAMME
// ============================================================================
// Une indisponibilité déclarée (congé, maladie, formation, autre) : sert de
// base à la détection de conflit avant affectation.
model Indisponibilite {
  id          String    @id @default(cuid())
  personnel   Personnel @relation(fields: [personnelId], references: [id])
  personnelId String
  dateDebut   DateTime
  dateFin     DateTime
  motif       String
  createdAt   DateTime  @default(now())

  @@index([personnelId])
}

enum StatutAffectation {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

// Affecter une personne à une affaire (et éventuellement un joint précis).
// La vérification (qualification, habilitation, disponibilité, compétence)
// se fait à la création et produit des alertes — voir src/lib/planning.ts —
// mais ne bloque jamais la création : conformément au cahier des charges
// ("signale... peut proposer"), Weldoc alerte, la décision reste humaine.
model Affectation {
  id          String            @id @default(cuid())
  personnel   Personnel         @relation(fields: [personnelId], references: [id])
  personnelId String
  affaire     Affaire           @relation(fields: [affaireId], references: [id])
  affaireId   String
  joint       Joint?            @relation(fields: [jointId], references: [id])
  jointId     String?
  fonction    String
  // Codes d'habilitation/accès site (ex. "CODES GTA" chez certains
  // clients) en texte libre : leur nomenclature est propre à
  // l'entreprise/au site, jamais interprétée par Weldoc.
  codes       String?
  dateDebut   DateTime
  dateFin     DateTime
  // Temps prévu (voir le cahier des charges, "TEMPS ET PRODUCTIVITÉ"), en
  // minutes, quand cette affectation concerne un joint précis (jointId
  // renseigné) — distinct du temps théorique (Wps.tempsTheoriqueMin) et
  // du temps réel (FicheTechniqueSoudage.tempsMin).
  dureeEstimeeMin Float?
  statut      StatutAffectation @default(PLANIFIEE)
  creeParId   String
  createdAt   DateTime          @default(now())

  @@index([personnelId])
  @@index([affaireId])
}

// Adresses email destinataires du récapitulatif d'alertes (envoyé chaque
// lundi — voir src/lib/alertesEmail.ts). Volontairement une simple liste
// d'adresses plutôt que rattachée à une fiche Personnel : ce ne sont pas
// forcément des comptes Weldoc (ex. la boîte mail d'un responsable qualité).
model DestinataireAlerte {
  id        String   @id @default(cuid())
  nom       String?
  email     String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================================
// SÉQUENCEMENT DU DOSSIER DE FABRICATION
// ============================================================================
enum StatutDemandeSequencement {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  MODIFICATION_DEMANDEE
}

// Demande de modification du séquencement envoyée par le terrain (ex. faire
// une phase avant une autre non encore terminée). Transmise au niveau 3, qui
// accepte/refuse/demande une modification/impose des conditions — jamais
// décidée automatiquement. Une demande ACCEPTEE autorise, pour les phases
// qu'elle liste, à passer outre le blocage "séquence précédente non
// terminée" (voir POST /api/phases et PATCH /api/phases).
model DemandeModificationSequencement {
  id                  String                    @id @default(cuid())
  affaire             Affaire                   @relation(fields: [affaireId], references: [id])
  affaireId           String
  phasesConcerneesIds String[]
  motif               String
  urgent              Boolean                   @default(false)
  photoUrl            String?
  documentUrl         String?
  demandeParId        String
  dateDemande         DateTime                  @default(now())
  statut              StatutDemandeSequencement @default(EN_ATTENTE)
  decisionParId       String?
  dateDecision        DateTime?
  commentaireDecision String?
  conditions          String?

  @@index([affaireId])
}

// ============================================================================
// PIÈCES (fabrication en atelier)
// ============================================================================
// Contrairement au chantier, où les joints d'une affaire sont en général
// connus à l'avance, une fabrication en atelier reçoit souvent des pièces
// au fil de l'eau. Une Pièce trace sa prise en charge (référence, photos
// des repères présents dessus comme preuve) et son statut au fil de
// l'activité — indépendamment des joints, qui restent la soudure elle-même.
enum StatutPiece {
  PRISE_EN_CHARGE
  EN_FABRICATION
  TERMINEE
  EXPEDIEE
}

model Piece {
  id                 String      @id @default(cuid())
  affaire            Affaire     @relation(fields: [affaireId], references: [id])
  affaireId          String
  reference          String
  designation        String?
  photosUrls         String[]
  priseEnChargeParId String
  datePriseEnCharge  DateTime    @default(now())
  statut             StatutPiece @default(PRISE_EN_CHARGE)
  // Joints/contrôles qui concernent cette pièce au fil de la fabrication
  // en atelier (voir Joint.pieceId ci-dessous) — la pièce reste l'objet
  // suivi (prise en charge → fabrication → terminée → expédiée), les
  // joints restent les soudures elles-mêmes, jamais dupliquées.
  joints             Joint[]

  @@unique([affaireId, reference])
  @@index([affaireId])
}

// ============================================================================
// BIBLIOTHÈQUE WPS/DMOS ET QMOS
// ============================================================================
// Une révision de WPS ou de QMOS n'écrase jamais la précédente : c'est un
// nouvel enregistrement, avec la même `reference` métier (ex. "DMOS-001")
// et une `version` différente (ex. "Rev 0", "Rev 1"). La version "en
// vigueur" n'est jamais stockée : elle est calculée à la lecture (la plus
// récente par dateEmission pour une référence donnée, voir
// src/lib/procedures.ts), comme le statut des qualifications ou de
// l'outillage ailleurs dans l'application. `retiree` est la seule chose
// qu'une personne peut positionner explicitement (ex. norme devenue
// obsolète), sans jamais modifier le contenu d'une version existante.
model Qmos {
  id             String    @id @default(cuid())
  reference      String
  version        String    @default("Rev 0")
  procede        String
  normeReference String
  laboratoire    String?
  dateEssai      DateTime?
  certificatUrl  String?
  retiree        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  wps            Wps[]
  joints         Joint[]

  @@unique([reference, version])
  @@index([reference])
}

// Type d'assemblage soudé, terminologie générique (pas propre à un
// référentiel) : bout-à-bout, angle, emmanché-soudé, rechargement.
enum TypeAssemblageSoudure {
  BOUT_A_BOUT
  ANGLE
  EMMANCHE_SOUDE
  RECHARGEMENT
  AUTRE
}

model Wps {
  id             String    @id @default(cuid())
  reference      String
  version        String    @default("Rev 0")
  typeAssemblage TypeAssemblageSoudure?
  procede        String
  normeReference String
  materiaux      String?
  // Groupe de matériaux (ex. ISO/TR 15608), structuré comme sur
  // Qualification.groupeMateriaux — c'est ce champ, avec procede, qui sert
  // de base au rapprochement automatique QS/WPS (voir
  // src/lib/verificationQS.ts), pas le texte libre `materiaux` ci-dessus.
  groupeMateriaux String?
  epaisseurMinMm Float?
  epaisseurMaxMm Float?
  diametreMinMm  Float?
  diametreMaxMm  Float?
  positions      String?
  // Notes libres sur la préparation (talon, jeu, mode de préparation,
  // support envers...) : le schéma lui-même (image/PDF) reste dans
  // documentUrl, pas reproduit en texte ici.
  preparationNotes String?
  qmos           Qmos?     @relation(fields: [qmosId], references: [id])
  qmosId         String?
  documentUrl    String?
  dateEmission   DateTime
  retiree        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  // Temps théorique de référence (voir le cahier des charges, "TEMPS ET
  // PRODUCTIVITÉ" : distinguer temps théorique/prévu/réel) — un barème
  // fixé par l'entreprise pour ce WPS, en minutes. Optionnel : reste vide
  // tant que l'entreprise n'a pas défini ce barème.
  tempsTheoriqueMin Float?

  joints         Joint[]
  passes         WpsPasse[]

  @@unique([reference, version])
  @@index([reference])
}

// Détail passe par passe d'un WPS/DMOS : ce qu'un soudeur suit réellement
// pendant le soudage. Créé avec le WPS et jamais modifié ensuite (comme le
// reste d'une révision) — une correction se fait via une nouvelle révision
// du WPS, avec ses propres passes.
model WpsPasse {
  id             String  @id @default(cuid())
  wps            Wps     @relation(fields: [wpsId], references: [id])
  wpsId          String
  ordre          Int
  procede        String
  modeOperatoire String?
  position       String?
  metalApportType String?
  metalApportDesignationNormalisee  String?
  metalApportDesignationCommerciale String?
  metalApportDiametreMm Float?
  gazEndroitNature   String?
  gazEndroitDebit    String?
  gazEnversNature    String?
  gazEnversDebit     String?
  natureCourantPolarite String?
  intensiteAMin      Float?
  intensiteAMax      Float?
  tensionVMin        Float?
  tensionVMax        Float?
  temperatureMiniPieceC       Float?
  temperatureMaxiEntrePassesC Float?
  observations   String?

  @@index([wpsId])
}

// Bibliothèque des procédures internes de l'entreprise (voir le cahier
// des charges, "DOCUMENTATION ET PROCÉDURES INTERNES") : procédure,
// instruction, formulaire, PV type, fiche technique... `type` reste en
// texte libre (ces catégories varient d'une entreprise à l'autre). Même
// principe de versionnage que WPS/QMOS (src/lib/procedures.ts,
// `annoterStatutProcedures`, réutilisé tel quel) : une nouvelle révision
// est un nouvel enregistrement, jamais une modification de la précédente.
model ProcedureInterne {
  id           String   @id @default(cuid())
  reference    String
  version      String   @default("Rev 0")
  titre        String
  type         String?
  documentUrl  String?
  dateEmission DateTime
  retiree      Boolean  @default(false)
  createdAt    DateTime @default(now())

  phases       Phase[]

  @@index([reference])
}
